rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role
    function isAdmin() {
      return request.auth.uid != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- Users Collection Rules ---
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth.uid != null && request.auth.uid == userId;
      allow update: if request.auth.uid != null && (
        request.auth.uid == userId || isAdmin()
      );
      allow delete: if false;
    }


    // --- Reports Collection Rules ---
    match /reports/{reportId} {
      allow create: if request.auth.uid != null;

      allow read: if request.auth.uid != null && (
        // Citizen can read only their own
        resource.data.uid == request.auth.uid ||
        // Providers/NGOs can read all
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['provider','ngo'] ||
        // Admin
        isAdmin()
      );

      allow update: if request.auth.uid != null && (
        // admin can update any
        isAdmin()
        ||
        // report owner can update their own
        resource.data.uid == request.auth.uid
        ||
        (
          // providers & ngos can set assignedTo to themselves and update status/notes/updatedAt
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['provider','ngo'])
          &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedTo','status','notes','updatedAt'])
          &&
          (request.resource.data.assignedTo == request.auth.uid || resource.data.assignedTo == request.auth.uid)
        )
      );

      allow delete: if request.auth.uid != null &&
        isAdmin();
    }

    // --- PublicReports Collection Rules ---
    match /publicReports/{reportId} {
      allow read: if true;

      function allowedKeysOnly() {
        return request.resource.data.keys().hasOnly([
          "reportId","title","type","status","lat","lng","approxArea","createdAt","location"
        ]);
      }

      // Writes: temporarily allow clients (authenticated) to write sanitized version.
      allow create: if request.auth.uid != null;
      allow update: if request.auth.uid != null && allowedKeysOnly();
      allow delete: if request.auth.uid != null &&
        isAdmin();
    }

    // --- Camps Collection Rules ---
    match /camps/{campId} {
      allow read: if isAdmin();
    }
    
    // --- Posts Collection Rules (Awareness Posts) ---
    match /posts/{postId} {
      allow read: if isAdmin();
    }


    // --- Referrals Collection Rules ---
    match /referrals/{referralId} {
      allow read: if request.auth.uid != null && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toProviderId ||
        isAdmin()
      );

      allow create: if request.auth.uid != null && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','provider','ngo']) &&
        request.resource.data.fromUid == request.auth.uid
      );

      // Allow updates:
      // - Admin can update any referral
      // - Recipient (toProviderId) can update status/respondedAt/responseNotes (accept/reject)
      // - Sender (fromUid) can cancel a pending referral by setting status == 'cancelled'
      allow update: if request.auth.uid != null && (
        isAdmin()
        ||
        (
          // Recipient updates
          request.auth.uid == resource.data.toProviderId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'responseNotes'])
        )
        ||
        (
          // Sender withdraws (only allowed to set status to 'cancelled' when current status is 'pending')
          request.auth.uid == resource.data.fromUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'responseNotes']) &&
          request.resource.data.status == 'cancelled' &&
          resource.data.status == 'pending'
        )
      );

      allow delete: if false;
    }


    // CONSULTATIONS
    match /consultations/{consultId} {
      allow read: if request.auth.uid != null && (
        // allow if user is creator, provider, patient or admin
        resource.data.creatorUid == request.auth.uid ||
        resource.data.providerUid == request.auth.uid ||
        resource.data.patientUid == request.auth.uid ||
        isAdmin() ||
        // NEW: Allow read if the user is the assigned provider or creator of the parent report
        (
          exists(/databases/$(database)/documents/reports/$(resource.data.reportId)) &&
          (get(/databases/$(database)/documents/reports/$(resource.data.reportId)).data.assignedTo == request.auth.uid ||
           get(/databases/$(database)/documents/reports/$(resource.data.reportId)).data.uid == request.auth.uid)
        )
      );

      // creator creates (usually provider), must match auth uid
      allow create: if request.auth.uid != null &&
        request.resource.data.creatorUid == request.auth.uid &&
        request.resource.data.reportId is string;

      // updates:
      allow update: if request.auth.uid != null && (
        // admin can update anything
        isAdmin()
        ||
        // provider may manage scheduling/session/notes/prescription/events
        (
          request.auth.uid == resource.data.providerUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','scheduledAt','jitsiRoom','notes','prescriptionText',
            'sessionStatus','sessionStartedAt','sessionEndedAt','updatedAt','events'
          ])
        )
        ||
        // patient may accept (confirm) or send decline note; can also update events
        (
          request.auth.uid == resource.data.patientUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','scheduledAt','updatedAt','lastRejectionNote','events'
          ])
        )
        ||
        // creator (if distinct) may only update notes
        (
          request.auth.uid == resource.data.creatorUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes','updatedAt'])
        )
      );

      allow delete: if false;
    }

    // NOTIFICATIONS
    match /notifications/{nid} {
      // Any auth user may create notifications (we keep it simple)
      allow create: if request.auth.uid != null && request.resource.data.toUid is string;
      // Only recipient may read or update their notifications (only 'read' field)
      allow read: if request.auth.uid != null && request.auth.uid == resource.data.toUid;
      allow update: if request.auth.uid != null && request.auth.uid == resource.data.toUid &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }


    // Rooms collection for WebRTC signaling
    match /rooms/{roomId} {
      allow read, write: if request.auth.uid != null && (
        // admin
        isAdmin() ||
        // Or user is a participant (provider or patient or creator) of the consultation with id == roomId
        (
          exists(/databases/$(database)/documents/consultations/$(roomId))
          &&
          (
            get(/databases/$(database)/documents/consultations/$(roomId)).data.providerUid == request.auth.uid ||
            get(/databases/$(database)/documents/consultations/$(roomId)).data.patientUid == request.auth.uid ||
            get(/databases/$(database)/documents/consultations/$(roomId)).data.creatorUid == request.auth.uid
          )
        )
      );

      // allow simple reads/writes to subcollections (candidates): same condition
      match /{sub=**} {
        allow read, write: if request.auth.uid != null && (
          isAdmin() ||
          (
            exists(/databases/$(database)/documents/consultations/$(roomId))
            &&
            (
              get(/databases/$(database)/documents/consultations/$(roomId)).data.providerUid == request.auth.uid ||
              get(/databases/$(database)/documents/consultations/$(roomId)).data.patientUid == request.auth.uid ||
              get(/databases/$(database)/documents/consultations/$(roomId)).data.creatorUid == request.auth.uid
            )
          )
        );
      }
    }


    // Blogs collection
    match /blogs/{blogId} {

      // Read: everyone can read
      allow read: if true;

      // Create: only authenticated users with role != "citizen"
      allow create: if request.auth.uid != null
                    && request.resource.data.creatorRole != "citizen";

      // Update/Delete: creator or admin can update/delete
      allow update, delete: if request.auth.uid != null &&
        isAdmin();
    }
    
    
    // Events collection rules
    match /events/{eventId} {
      allow read: if true;

      allow create: if request.auth.uid != null &&
                    (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','ngo']);

      allow update: if request.auth.uid != null && (
        // event creator or admin can update anything
        resource.data.uid == request.auth.uid ||
        isAdmin() ||
        // allow any authenticated user to change ONLY participantsCount by +1 or -1
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantsCount']) &&
          (
            request.resource.data.participantsCount == resource.data.participantsCount + 1 ||
            request.resource.data.participantsCount == resource.data.participantsCount - 1
          )
        )
      );

      allow delete: if request.auth.uid != null &&
                    (resource.data.uid == request.auth.uid ||
                     isAdmin());

      // participants subcollection rules...
      match /participants/{participantId} {
        allow read: if request.auth.uid != null && (
          isAdmin() ||
          get(/databases/$(database)/documents/events/$(eventId)).data.uid == request.auth.uid ||
          request.auth.uid == participantId
        );

        allow create: if request.auth.uid != null && request.auth.uid == participantId;

        allow delete: if request.auth.uid != null &&
                       (request.auth.uid == participantId ||
                        isAdmin() ||
                        get(/databases/$(database)/documents/events/$(eventId)).data.uid == request.auth.uid);

        allow update: if false;
      }
    }
  }
}
